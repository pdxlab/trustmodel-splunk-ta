<dashboard version="1.1" theme="dark">
  <label>TrustModel AI Risk</label>
  <description>Evaluation lifecycle, findings, and AI risk telemetry from TrustModel — surfaced in Splunk via HEC.</description>

  <!-- Time range input — applies to every panel below -->
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time_range">
      <label>Time range</label>
      <default>
        <earliest>-7d@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>

  <!-- ────────── Top row: Single-value tiles ────────── -->
  <row>
    <panel>
      <title>Total events</title>
      <single>
        <search>
          <query>sourcetype="trustmodel:*" earliest=$time_range.earliest$ latest=$time_range.latest$ | stats count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0x0877a6","0xf8be34","0xf1813f","0xdc4e41"]</option>
        <option name="rangeValues">[0,10,100,1000]</option>
        <option name="useColors">1</option>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>

    <panel>
      <title>High-severity findings</title>
      <single>
        <search>
          <query>sourcetype="trustmodel:finding" severity IN (high, critical) earliest=$time_range.earliest$ latest=$time_range.latest$ | stats count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xf1813f","0xdc4e41","0xb50101"]</option>
        <option name="rangeValues">[0,1,5,20]</option>
        <option name="useColors">1</option>
        <option name="drilldown">none</option>
      </single>
    </panel>

    <panel>
      <title>Avg eval score</title>
      <single>
        <search>
          <query>sourcetype="trustmodel:eval" event_type=eval.completed earliest=$time_range.earliest$ latest=$time_range.latest$ | stats avg(overall_score) as avg_score | eval avg_score=round(avg_score, 1)</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0xdc4e41","0xf1813f","0xf8be34","0x0877a6","0x53a051"]</option>
        <option name="rangeValues">[40,60,80,90]</option>
        <option name="useColors">1</option>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0.1</option>
      </single>
    </panel>

    <panel>
      <title>Eval runs</title>
      <single>
        <search>
          <query>sourcetype="trustmodel:eval" event_type=eval.completed earliest=$time_range.earliest$ latest=$time_range.latest$ | stats count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <!-- ────────── Second row: Time series + composition ────────── -->
  <row>
    <panel>
      <title>Events over time</title>
      <chart>
        <search>
          <query>sourcetype="trustmodel:*" earliest=$time_range.earliest$ latest=$time_range.latest$ | timechart count by sourcetype</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">right</option>
        <option name="charting.axisTitleY.text">Events</option>
      </chart>
    </panel>

    <panel>
      <title>Findings by severity</title>
      <chart>
        <search>
          <query>sourcetype="trustmodel:finding" earliest=$time_range.earliest$ latest=$time_range.latest$ | stats count by severity | sort -count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
  </row>

  <!-- ────────── Third row: Dimensional breakdowns ────────── -->
  <row>
    <panel>
      <title>Findings by dimension</title>
      <chart>
        <search>
          <query>sourcetype="trustmodel:finding" earliest=$time_range.earliest$ latest=$time_range.latest$ | stats count by dimension | sort -count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.axisTitleX.text">Findings</option>
      </chart>
    </panel>

    <panel>
      <title>Avg eval score by source</title>
      <chart>
        <search>
          <query>sourcetype="trustmodel:eval" event_type=eval.completed earliest=$time_range.earliest$ latest=$time_range.latest$ | stats avg(overall_score) as avg_score by eval_source | eval avg_score=round(avg_score, 1) | sort -avg_score</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.axisTitleY.text">Score (0-100)</option>
        <option name="charting.chart.rangeValues">[0,100]</option>
      </chart>
    </panel>
  </row>

  <!-- ────────── Fourth row: Top offenders + live tail ────────── -->
  <row>
    <panel>
      <title>Top failing signatures</title>
      <table>
        <search>
          <query>sourcetype="trustmodel:finding" earliest=$time_range.earliest$ latest=$time_range.latest$ | stats count, values(severity) as severity, values(dimension) as dimension by signature, eval_source | sort -count | head 10</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">10</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Recent findings (live tail — last 15m)</title>
      <table>
        <search>
          <query>sourcetype="trustmodel:finding" earliest=-15m | sort -_time | table _time eval_source dimension severity signature description | head 30</query>
          <earliest>-15m</earliest>
          <latest>now</latest>
          <refresh>30s</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
        <option name="count">30</option>
      </table>
    </panel>
  </row>
</dashboard>
